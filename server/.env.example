# CHM web server — environment variables (Phase 2). No real values here, ever.

# Server state: config.json, trash/, documents/ (Setlists), hash-index.json.
# Default: ./data (relative to the working directory).
CHM_DATA_DIR=./data

# The Songs library the app manages. Source of truth — config:set cannot
# change it. Default: <CHM_DATA_DIR>/library.
CHM_LIBRARY_ROOT=/path/to/Clone Hero/Songs

# Duplicate-quarantine directory. dialog:chooseDir returns it (created on
# demand) and lib:moveOut only accepts destinations inside it.
# Default: <CHM_DATA_DIR>/quarantine.
#CHM_QUARANTINE_DIR=

# HTTP bind. Defaults: 3000 / 0.0.0.0 (LAN service — see the security model in
# docs/port/plan.md: no auth, the network is the trust boundary).
#CHM_PORT=3000
#CHM_HOST=0.0.0.0

# Renderer static build to serve (Phase 3 output). Relative paths resolve
# against the server/ directory. Default: ../app/out/renderer.
#CHM_STATIC_DIR=../app/out/renderer

# External tools (wired in Phase 5/6).
# Directory containing the 7-Zip CLI (7z / 7zz):
#CHM_7Z_DIR=
# Path to the Onyx CLI binary (CON conversion, feature-flagged):
#CHM_ONYX_PATH=
