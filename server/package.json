{
  "name": "chm-server",
  "version": "0.1.0",
  "private": true,
  "description": "Clone Hero Chart Manager — self-hosted web server (Phase 2 skeleton). Hosts the unmodified app/src/main/core modules behind a Fastify HTTP + SSE API.",
  "license": "MIT",
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "postinstall": "node scripts/sync-core.mjs",
    "predev": "node scripts/sync-core.mjs",
    "prebuild": "node scripts/sync-core.mjs",
    "pretypecheck": "node scripts/sync-core.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "electron": "file:src/shims/electron",
    "fastify": "^5.0.0",
    "parse-sng": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
